    {"id": "phase", "real": "kslice_real.dat", "imag": "kslice_imag.dat", "part": "phase", "norm": "phase", "cmap": "twilight", "math_title": "$\\arg R$", "order": 4, "colorbar_label": "$\\arg R$ (rad)"}
